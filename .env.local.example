# Copy to .env.local (gitignored) and fill in.
#
# Project keys:
#   npx supabase projects api-keys --project-ref bfhxbvaosagfrkuhnuvp

# --- Supabase: app reads (anon/publishable key, RLS select-only) ---
NEXT_PUBLIC_SUPABASE_URL=https://bfhxbvaosagfrkuhnuvp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: pipeline writes (service key, bypasses RLS — scripts only) ---
SUPABASE_SERVICE_ROLE_KEY=

# Used by the Supabase CLI for migrations (supabase db push)
SUPABASE_DB_PASSWORD=

# --- Dataset selection ---
# Which batch the app reads and the lanes write. See lib/dataset.ts.
ACTIVE_BATCH=dev
# ACTIVE_AGENT_ID=gemini-2.0-flash

# --- Local dev without a backend ---
# "true" renders lib/fake-data.ts fixtures. Anything else reads Supabase.
USE_FAKE_DATA=true

# --- Lane 2 (agent harness) ---
GEMINI_API_KEY=
